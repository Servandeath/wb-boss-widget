{
  "manifest_version": 3,
  "name": "WB Boss Widget",
  "version": "0.1.0",
  "description": "Показатели по нескольким кабинетам Wildberries в popup-окне",
  "permissions": ["storage"],
  "host_permissions": ["http://127.0.0.1:8000/*"],
  "action": {
