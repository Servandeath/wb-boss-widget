# Скопируй в backend/.env и впиши реальные значения.
# backend/.env в .gitignore - не коммитится.

# ---------------------------------------------------------------
# Google Sheets - сервис-аккаунт (см. backend/credentials.json)
# ---------------------------------------------------------------
# Email сервис-аккаунта: sheets-reader@project-is-named-after-me.iam.gserviceaccount.com
# Каждую таблицу ниже (cost-sheets и архивную таблицу заказов/продаж) нужно
# расшарить на этот email как минимум с правом "Читатель" (Viewer) - иначе
# backend получит 403 при чтении. Расшаривает владелец таблицы в Google
# Sheets: Настройки доступа -> добавить email -> Читатель.
GOOGLE_SHEETS_CREDENTIALS_FILE=backend/credentials.json
GOOGLE_SHEETS_SPREADSHEET_ID=1CXqoIij9ZkFi9PnBDRShsjoJu9vGwgn4hJUuvtwVhLE

# ---------------------------------------------------------------
# Кабинеты WB - список кодов через запятую.
# Код - латиницей (id для env-переменных и кода), имя - как в Sheets/виджете.
#
# Бурков -> Мелуа: ребренд, тот же кабинет WB, новое название по бренду
# (кабинеты называются по бренду, не по юрлицу). Код кабинета оставлен
# MELUA, старое имя "Бурков" - только для истории/поиска в архивах.
# ---------------------------------------------------------------
WB_CABINETS=MANI,MIROS,MELUA,BURKOVA

WB_CABINET_MANI_NAME=МАНИ
WB_CABINET_MIROS_NAME=МИРОС
WB_CABINET_MELUA_NAME=Мелуа
WB_CABINET_BURKOVA_NAME=Буркова

# ---------------------------------------------------------------
# WB API токены - один общий токен на кабинет (все нужные категории
# доступа выданы на один токен в личном кабинете WB).
# ---------------------------------------------------------------
WB_TOKEN_MANI=
WB_TOKEN_MIROS=
WB_TOKEN_MELUA=
WB_TOKEN_BURKOVA=

# ---------------------------------------------------------------
# Временные таблицы себестоимости и прочих данных по кабинетам
# (пока нет своей системы). На кабинет может быть несколько таблиц -
# добавляй с суффиксом _1, _2, ... и своим комментарием, что в какой.
#
# Пример:
# COST_SHEET_URL_MANI_1=https://docs.google.com/spreadsheets/d/xxx  # себестоимость
# COST_SHEET_URL_MANI_2=https://docs.google.com/spreadsheets/d/yyy  # логистика
# ---------------------------------------------------------------
COST_SHEET_URL_MANI_1=
COST_SHEET_URL_MIROS_1=
COST_SHEET_URL_MELUA_1=
COST_SHEET_URL_BURKOVA_1=
